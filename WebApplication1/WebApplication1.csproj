<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- ASP.NET Core usa .NET 10 y una clave de secretos de desarrollo para su configuración local. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>VantexNova-Universidad</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- El servidor necesita el script SQL junto a la aplicación cuando configura la base. -->
    <Content Include="Datos/Vantex.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
